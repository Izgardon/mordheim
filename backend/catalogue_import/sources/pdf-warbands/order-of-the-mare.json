  "warbandRules": {
    "startingGc": 500,
    "maxModels": 15
  },
  "specialRules": [
    {
      "rulename": "Hired Swords",
      "ruleFull": "The warband may hire the same Hired Swords and Dramatis Personae as a Mercenary warband."
    },
    {
      "rulename": "Horse and rider",
      "ruleFull": "When the Paragon and the Gallant are recruited, each may buy a single horse or warhorse at half the normal price."
    },
    {
      "rulename": "A Dame without delay",
      "ruleFull": "The warband must hold a Dame of the Mare. If she is lost, a new one is recruited before any other warrior."
    },
    {
      "rulename": "Blazing Saddles",
      "ruleFull": "If the Blazing Saddles supplement (Town Cryer 14) is in play, the Paragon, the Gallant, the Esquiresses and the Redeemed knights all have the Ride skill, and the warband may ignore the limit of two mounts in areas of dense terrain."
    }
  ],
