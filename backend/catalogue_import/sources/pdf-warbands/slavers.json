  "specialRules": [
    {
      "rulename": "Slave trade",
      "ruleFull": "The warband counts as gaining one extra piece of treasure after every battle, for the slaves it sells who do not fight."
    },
    {
      "rulename": "Lad's got the talent",
      "ruleFull": "When a slave gains the Lad's Got the Talent advance, he takes a Leadership test. Passed, he is freed: he keeps his profile, becomes a Caravan Guard, may become the warband's leader, and loses every special rule of being a slave. Failed, he is taken off the warband list and becomes a new Eunuch in a henchmen group of his own. Roll advances for any slave left in the group as normal."
    },
    {
      "rulename": "Room for slaves",
      "ruleFull": "The warband may hold 20 warriors while hiring its heroes and henchmen gives at most 12, so the rest are slaves it buys."
    }
  ],
