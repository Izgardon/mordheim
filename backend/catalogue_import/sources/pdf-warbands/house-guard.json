  "specialRules": [
    {
      "rulename": "Chain of Command",
      "ruleFull": "If the warband's leader is taken out of action, work out a new temporary leader at once, as if the leader had been killed for good. He is in charge and has the Leader ability until the end of the game or until he too is taken out of action, when the warband works out another."
    },
    {
      "rulename": "Personal Guard",
      "ruleFull": "Every Hero and Henchman of a House Guard intercepts a charge at a friendly Hero within 3\" instead of the usual 2\". In the Assassination scenario they may ignore the attacker's evasive rule when their protege is the target."
    },
    {
      "rulename": "Dueling Pride",
      "ruleFull": "A Fierezza Hero may re-roll failed hits in the first round of combat when he fights an enemy Hero.",
      "variant": "fierezza"
    },
    {
      "rulename": "Sharp Aim",
      "ruleFull": "Every warrior of House Halcon ignores the long range modifier when he fires a missile weapon.",
      "variant": "halcon"
    },
    {
      "rulename": "Armour",
      "ruleFull": "A Baluardo Hero suffers no movement penalty for wearing armour.",
      "variant": "baluardo"
    }
  ],
