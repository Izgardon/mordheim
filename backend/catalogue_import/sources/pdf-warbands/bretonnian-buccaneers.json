  "warbandRules": {
    "startingGc": 500,
    "maxModels": 15
  },
  "specialRules": [
    {
      "rulename": "Swabbies",
      "ruleFull": "The warband's Swabbies are human, and are captured rather than hired, under the Sartosa campaign rules."
    },
    {
      "rulename": "Hired Swords",
      "ruleFull": "The warband hires Hired Swords and buys other items as a human Mercenary warband does. A warband holding both Dwarfs and Elves pays 20 gold crowns more in upkeep."
    },
    {
      "rulename": "Swivel Guns are Rare, Matey!",
      "ruleFull": "The warband may not start a campaign game with a Swivel Gun on its roster. In a one-off game it may buy one for 2D6 gold crowns more."
    },
    {
      "rulename": "Duellists",
      "ruleFull": "When a Hero shoots with a Pistol, its first 6\" count as short range; with a Duelling Pistol, its first 10\" count as short range. With the Eagle Eye skill, the 6\" that skill adds count as long range."
    },
    {
      "rulename": "Succession",
      "ruleFull": "If the Captain is killed, one of the Mates takes his place, as a Champion does in a Mercenary warband."
    }
  ],
